# Copy to .env, then load it before starting Claude Code:
#   set -a; source .env; set +a; claude
# Claude Code does not read .env by itself.

# Alias of the only org the agents may touch (your dev sandbox).
SF_TARGET_ORG=my-dev-sandbox

# Not used locally: for the optional CI, store the integration user's
# sfdx auth URL as the GitHub secret SFDX_AUTH_URL_DEV, never in this file.
